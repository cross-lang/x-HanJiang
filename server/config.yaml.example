# 汉江（HanJiang）默认配置文件
# 优先级：环境变量 > 环境特定配置(config.{env}.yaml) > 本文件 > 代码默认值
# 与 .env.example 保持完全一致的配置字段和语义

app_env: "development"

server:
  host: "0.0.0.0"
  port: 8000
  debug: false
  workers: 1

logging:
  level: "INFO"
  # json — 结构化 JSON 日志（适合 Loki / ELK 收集，生产默认）
  # console — 彩色人可读格式（适合本地开发）
  format: "json"
  file_path: "logs/x-HanJiang-{time:YYYYMMDDHH}.log"
  rotation: "1 hour"
  retention: "7 days"
  compression: "zip"
  console_output: true

cors:
  origins:
    - "*"

rate_limit:
  per_minute: 60

auth:
  # JWT 签名密钥（HS256）。
  # 开发环境可使用下方默认值；生产环境必须通过 AUTH_SECRET_KEY 环境变量
  # 覆盖为至少 32 字符的随机字符串，生成方式：
  #   python -c "from src.core.security import generate_secret_key; print(generate_secret_key())"
  secret_key: "dev-only-change-me-in-production"
  algorithm: "HS256"
  access_token_expire_minutes: 10080
  refresh_token_expire_days: 30

database:
  host: "localhost"
  port: 3306
  root_password: ""
  user: "yeyushilai"
  password: ""
  database: "hanjiang"
  pool_size: 5

redis:
  host: "localhost"
  port: 6379
  user: "default"
  password: ""
  db: 0

# ============================================================
# 统一存储抽象层配置
# provider: "local"（本地文件系统）| "s3"（S3 兼容对象存储）
# 切换存储后端只需修改 provider 字段，业务代码零改动
# ============================================================
storage:
  provider: "local"
  local:
    base_dir: "statics"
  s3:
    # S3 兼容服务地址（七牛 Kodo 格式：https://s3.<region>.qiniucs.com）
    endpoint_url: "https://s3.cn-south-1.qiniucs.com"
    access_key: ""
    secret_key: ""
    bucket: "x-hanjiang"
    # 存储区域（标准 S3 区域标识，七牛 Kodo 华南：cn-south-1）
    region: "cn-south-1"
    prefix: "uploads"
    # 公开访问域名（可选，含协议头，如 https://cdn.example.com）
    public_url: ""
    use_ssl: true

# ============================================================
# SMTP 邮件配置（用于发送密码重置邮件等）
# QQ 邮箱：smtp.qq.com, 端口 465(SSL) 或 587(TLS), 密码填授权码
# 163 邮箱：smtp.163.com, 端口 465(SSL) 或 25, 密码填授权码
# ============================================================
smtp:
  host: "smtp.qq.com"
  port: 465
  username: "xxx@XXX.com"
  password: ""
  use_tls: true
  from_name: "HanJiang"
  from_address: "xxx@XXX.com"

# ============================================================
# 通知渠道配置
# 支持的渠道：email（复用 SMTP 配置）、dingtalk、feishu、sms
# ============================================================
notification:
  enabled: true
  # 重试 Worker 轮询间隔（秒）
  retry_interval_seconds: 60
  # 健康检查告警接收邮箱（留空则不触发告警）
  alert_email: ""
  # 钉钉
  # 方式一：工作通知（推荐，per-user 投递）
  dingtalk_app_key: ""
  dingtalk_app_secret: ""
  dingtalk_agent_id: ""
  # 方式二：群机器人 Webhook（群广播，不区分接收人）
  dingtalk_webhook: ""
  dingtalk_secret: ""
  # 飞书
  # 方式一：应用消息（推荐，per-user 投递，receive_id 填 open_id）
  feishu_app_id: ""
  feishu_app_secret: ""
  # 方式二：群机器人 Webhook（群广播，不区分接收人）
  feishu_webhook: ""
  feishu_secret: ""
  # 短信（留空则不启用，需接入 SMS SDK）
  sms_access_key: ""
  sms_secret_key: ""
  sms_sign_name: ""
  sms_template_code: ""

# ============================================================
# AI 助手配置
# llm.provider: "openai_compat"（OpenAI 兼容协议，可对接小米 MiMo / DeepSeek /
#               豆包火山方舟 / 通义 / 本地 vLLM 等，通过 base_url 切换）
# 默认大模型：小米 MiMo mimo-v2.6-pro（文本推理更强）；
#             如需图片理解能力，model 改为 "mimo-v2.5"
# memory:      第 2 层（滚动摘要）+ 第 3 层（最近原文）记忆参数
# retriever:   RAG 预留，默认未启用（provider: "null"）
# tools:       MCP 工具源预留，默认关闭
# 敏感信息（api_key）建议通过环境变量注入：AI_LLM_API_KEY=xxx
# ============================================================
ai:
  enabled: true
  llm:
    provider: "openai_compat"
    base_url: "https://api.xiaomimimo.com/v1"
    api_key: ""
    model: "mimo-v2.6-pro"
    temperature: 0.7
    max_tokens: 2048
    timeout_seconds: 60
    # 单轮对话整体超时秒数（含工具调用），超过则主动终止并下发 error
    chat_request_timeout_seconds: 180
  memory:
    enabled: true
    # 第 3 层：保留的最近原文轮数（一轮 = 一问一答）
    recent_raw_rounds: 6
    # 历史上下文 token 预算上限（不含系统提示词与输出预留）
    token_budget: 32000
    # 滚动摘要使用的模型（留空复用主模型）
    summary_model: ""
  retriever:
    enabled: false
    provider: "null"
    top_k: 3
  tools:
    # MCP 工具源开关（预留，接入 MCP 后置为 true）
    mcp_enabled: false
    mcp_server_url: ""
    # MCP 扩展参数（JSON 字符串，预留）
    mcp_extra_config: ""
