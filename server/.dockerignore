# 虚拟环境与依赖缓存（容器内由 uv 重新安装）
.venv/
venv/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# 日志与运行时产物
logs/
*.log
tmp/

# 构建镜像不需要的目录
tests/
docs/
examples/
scripts/
statics/

# 环境变量与密钥（绝不进入镜像构建上下文）
.env
.env.*
*.pem
*.key

# 版本控制
.git
.gitignore
