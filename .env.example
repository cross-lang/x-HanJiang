# 寒江（HanJiang）环境变量配置
# 优先级：环境变量 > 环境特定配置(config.{env}.yaml) > 本文件 > 代码默认值
# 与 config.yaml.example 保持完全一致的字段命名和语义

# 运行环境：development / testing / production
APP_ENV=development

# 服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_DEBUG=true
SERVER_WORKERS=1

# 日志配置
LOGGING_LEVEL=INFO
# 日志格式：json（结构化，适合 Loki/ELK）| console（彩色人可读，适合本地开发）
LOGGING_FORMAT=json
LOGGING_FILE_PATH=logs/x-HanJiang-{time:YYYYMMDDHH}.log
LOGGING_ROTATION=1 hour
LOGGING_RETENTION=7 days
LOGGING_COMPRESSION=zip
LOGGING_CONSOLE_OUTPUT=true

# 跨域配置
CORS_ORIGINS=["*"]

# 限流配置
RATE_LIMIT_PER_MINUTE=60

# JWT 认证配置
# 生产环境必须覆盖为至少 32 字符的随机字符串，可使用：
# python -c "from src.core.security import generate_secret_key; print(generate_secret_key())"
AUTH_SECRET_KEY=lj2L1lqwsnmp0FlgshhbBchk3HrjlNyfLA2BQW0Sp8uitykQTlXsmZqzjB4pss8w
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30

# MySQL 凭据
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_USER=root
MYSQL_PASSWORD=change-me-user-password
MYSQL_DATABASE=hanjiang
DATABASE_POOL_SIZE=5

# Redis 凭据
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=change-me-redis-password
REDIS_DB=0

# 存储配置（local | s3）
STORAGE_PROVIDER=local
# 本地存储目录（provider=local 时生效）
STORAGE_LOCAL_BASE_DIR=static
# S3 兼容存储配置（provider=s3 时生效，支持七牛 Kodo S3 API / AWS S3 / MinIO）
# 七牛 Kodo endpoint 格式：https://s3.<region>.qiniucs.com
STORAGE_S3_ENDPOINT_URL=https://s3.cn-south-1.qiniucs.com
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_BUCKET=x-hanjiang
# 存储区域（标准 S3 区域标识，七牛 Kodo 华南：cn-south-1）
STORAGE_S3_REGION=cn-south-1
STORAGE_S3_PREFIX=uploads
# 公开访问域名（可选，含协议头，如 https://cdn.example.com）
STORAGE_S3_PUBLIC_URL=
STORAGE_S3_USE_SSL=true

# SMTP 邮件配置（用于发送密码重置邮件等）
# QQ 邮箱：smtp.qq.com, 端口 465(SSL) 或 587(TLS), 密码填授权码
# 163 邮箱：smtp.163.com, 端口 465(SSL) 或 25, 密码填授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=xxx@XXX.com
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_NAME=HanJiang
SMTP_FROM_ADDRESS=xxx@XXX.com

# 密码重置配置
# 重置令牌有效期（分钟）
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
# 每小时最大重置请求次数（防暴力破解）
PASSWORD_RESET_MAX_ATTEMPTS_PER_HOUR=5
# 前端重置密码页面 URL（邮件中的链接会指向此地址）
PASSWORD_RESET_FRONTEND_URL=http://localhost:3000
