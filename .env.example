# 汉江（HanJiang）Docker Compose 环境变量模板
# 用法：cp .env.example .env，替换下面的占位值后执行 docker compose up -d --build
# 标 [必填] 的变量缺失时 compose 会直接拒绝启动（${VAR:?} 校验）

# 运行环境：compose 容器化部署固定 production（触发 config.production.yaml 与生产配置校验）
APP_ENV=production
SERVER_DEBUG=false

# [必填] JWT 签名密钥：至少 32 字符的随机字符串，各环境必须独立
# 生成方式：python -c "from src.core.security import generate_secret_key; print(generate_secret_key())"
AUTH_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# [必填] MySQL 应用账号密码（应用使用独立普通账号，禁止使用 root）
MYSQL_USER=hanjiang
MYSQL_PASSWORD=change-me-mysql-password
# [必填] MySQL root 管理密码（仅初始化与运维使用）
MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
MYSQL_DATABASE=hanjiang

# [必填] Redis 密码
REDIS_PASSWORD=change-me-redis-password

# Gunicorn worker 数：容器内存上限 1G，默认 4 会 OOM，建议 2
GUNICORN_WORKERS=2

# AI 助手大模型密钥：留空则 AI 助手不可用，其余功能不受影响
AI_LLM_API_KEY=

# CORS 白名单（走 nginx 同域 /api/ 反代时无需配置；vite dev 直连后端时按需放开）
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
