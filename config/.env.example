# 寒江（HanJiang）环境变量配置
# 优先级：环境变量 > 环境特定配置(config.{env}.yaml) > 本文件 > 代码默认值
# 与 config.yaml.example 保持完全一致的字段命名和语义

# 运行环境：development / testing / production
APP_ENV=development

# 服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# 日志配置
LOGGING_LEVEL=INFO
LOGGING_FILE_PATH=logs/x-HanJiang-{time:YYYYMMDDHH}.log
LOGGING_ROTATION=1 hour
LOGGING_RETENTION=7 days

# 跨域配置
CORS_ORIGINS=["*"]

# 限流配置
RATE_LIMIT_PER_MINUTE=60

# JWT 认证配置
# 生产环境必须覆盖为至少 32 字符的随机字符串，可使用：
# python -c "from src.core.security import generate_secret_key; print(generate_secret_key())"
AUTH_SECRET_KEY=dev-only-change-me-in-production
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=10080
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30

# 数据库连接（MySQL）
# 格式：mysql://用户名:密码@主机:端口/数据库名
# 或使用 pymysql 驱动：mysql+pymysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql://root:CHANGE_ME@localhost:3306/hanjiang
DATABASE_POOL_SIZE=5

# Redis 连接
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# 对象存储配置（Qiniu Kodo / S3 兼容）
# endpoint 请从对象存储控制台获取，按对应区域填写 S3 兼容地址
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=x-hanjiang
OBJECT_STORAGE_REGION=cn-east-1
OBJECT_STORAGE_PREFIX=uploads
# 若桶为公有读，填写访问域名；私有桶留空
OBJECT_STORAGE_PUBLIC_URL=
OBJECT_STORAGE_USE_SSL=true
