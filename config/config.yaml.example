# 寒江（HanJiang）默认配置文件
# 优先级：环境变量 > 环境特定配置(config.{env}.yaml) > 本文件 > 代码默认值
# 与 .env.example 保持完全一致的配置字段和语义

app_env: "development"

server:
  host: "0.0.0.0"
  port: 8000
  debug: true
  workers: 1

logging:
  level: "INFO"
  file_path: "logs/x-HanJiang-{time:YYYYMMDDHH}.log"
  rotation: "1 hour"
  retention: "7 days"

cors:
  origins:
    - "*"

rate_limit:
  per_minute: 60

auth:
  # JWT 签名密钥（HS256）。
  # 开发环境可使用下方默认值；生产环境必须通过 AUTH_SECRET_KEY 环境变量
  # 覆盖为至少 32 字符的随机字符串，生成方式：
  #   python -c "from src.core.security import generate_secret_key; print(generate_secret_key())"
  secret_key: "dev-only-change-me-in-production"
  algorithm: "HS256"
  access_token_expire_minutes: 10080
  refresh_token_expire_days: 30

database:
  url: "mysql://root:CHANGE_ME@localhost:3306/hanjiang"
  pool_size: 5

redis:
  url: "redis://:CHANGE_ME@localhost:6379/0"

object_storage:
  endpoint_url: ""
  access_key: ""
  secret_key: ""
  bucket: "x-hanjiang"
  region: "cn-east-1"
  prefix: "uploads"
  public_url: ""
  use_ssl: true
