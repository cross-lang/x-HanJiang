# 汉匠（HanJiang）默认配置文件
# 优先级：环境变量 > 环境特定配置(config.{env}.yaml) > 本文件 > 代码默认值
# 与 .env.example 保持完全一致的配置字段和语义

app_env: "development"

server:
  host: "0.0.0.0"
  port: 8000
  debug: true
  workers: 1

logging:
  level: "INFO"
  # json — 结构化 JSON 日志（适合 Loki / ELK 收集，生产默认）
  # console — 彩色人可读格式（适合本地开发）
  format: "json"
  file_path: "logs/x-HanJiang-{time:YYYYMMDDHH}.log"
  rotation: "1 hour"
  retention: "7 days"
  compression: "zip"
  console_output: true

cors:
  origins:
    - "*"

rate_limit:
  per_minute: 60

auth:
  # JWT 签名密钥（HS256）。
  # 开发环境可使用下方默认值；生产环境必须通过 AUTH_SECRET_KEY 环境变量
  # 覆盖为至少 32 字符的随机字符串，生成方式：
  #   python -c "from src.core.security import generate_secret_key; print(generate_secret_key())"
  secret_key: "dev-only-change-me-in-production"
  algorithm: "HS256"
  access_token_expire_minutes: 10080
  refresh_token_expire_days: 30

database:
  host: "localhost"
  port: 3306
  root_password: ""
  user: "root"
  password: ""
  database: "hanjiang"
  pool_size: 5

redis:
  host: "localhost"
  port: 6379
  user: "default"
  password: ""
  db: 0

# ============================================================
# 统一存储抽象层配置
# provider: "local"（本地文件系统）| "s3"（S3 兼容对象存储）
# 切换存储后端只需修改 provider 字段，业务代码零改动
# ============================================================
storage:
  provider: "local"
  local:
    base_dir: "static"
  s3:
    # S3 兼容服务地址（七牛 Kodo 格式：https://s3.<region>.qiniucs.com）
    endpoint_url: "https://s3.cn-south-1.qiniucs.com"
    access_key: ""
    secret_key: ""
    bucket: "x-hanjiang"
    # 存储区域（标准 S3 区域标识，七牛 Kodo 华南：cn-south-1）
    region: "cn-south-1"
    prefix: "uploads"
    # 公开访问域名（可选，含协议头，如 https://cdn.example.com）
    public_url: ""
    use_ssl: true

# ============================================================
# SMTP 邮件配置（用于发送密码重置邮件等）
# QQ 邮箱：smtp.qq.com, 端口 465(SSL) 或 587(TLS), 密码填授权码
# 163 邮箱：smtp.163.com, 端口 465(SSL) 或 25, 密码填授权码
# ============================================================
smtp:
  host: "smtp.qq.com"
  port: 465
  username: "xxx@XXX.com"
  password: ""
  use_tls: true
  from_name: "HanJiang"
  from_address: "xxx@XXX.com"

# ============================================================
# 密码重置配置
# ============================================================
password_reset:
  # 重置令牌有效期（分钟）
  token_expire_minutes: 15
  # 每小时最大重置请求次数（防暴力破解）
  max_attempts_per_hour: 5
  # 前端重置密码页面 URL（邮件中的链接会指向此地址）
  frontend_url: "http://localhost:3000"
